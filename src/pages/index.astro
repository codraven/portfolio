---
import "../styles/global.css";

const NAV = [
  { id: "summary", n: "01", label: "Summary" },
  { id: "skills", n: "02", label: "Stack" },
  { id: "experience", n: "03", label: "Experience" },
  { id: "projects", n: "04", label: "Projects" },
  { id: "education", n: "05", label: "Education" },
  { id: "contact", n: "06", label: "Contact" },
];

const STATS = [
  { n: 90, suffix: "%", l: "Code-gen quality · manual review" },
  { n: 17, suffix: "×", l: "Faster F1 · Groq vs Gemini" },
  { n: 10, suffix: "+", l: "LLM providers routed" },
  { n: 100, suffix: "%", l: "Precision · CUAD key clauses" },
];

const SKILLS = [
  { h: "AI / ML / LLM", items: ["LLMs", "AI Agents", "Multi-Agent Systems", "LangChain", "LangGraph", "LangSmith", "RAG", "pgvector", "Embeddings", "Vision Language Models", "Prompt Engineering", "Function Calling", "Agent Tooling", "Hugging Face", "MCP", "Generative AI"] },
  { h: "Backend & APIs", items: ["FastAPI", "Pydantic", "SQLAlchemy", "Alembic", "REST Design", "Async", "WebSocket / SSE", "OpenTelemetry"] },
  { h: "AI Security & Governance", wide: true, items: ["AI Governance", "EU AI Act", "ISO/IEC 42001", "NIST AI RMF", "OWASP LLM Top 10", "MITRE ATLAS", "AI Gateway Patterns", "LLM Routing & Failover", "OIDC / SSO Fundamentals", "AI Incident Response", "Audit Logging", "LLM Cost Observability"] },
  { h: "Languages & Data", items: ["Python", "SQL", "PostgreSQL", "MySQL", "MongoDB"] },
  { h: "Cloud / DevOps / Frontend", items: ["GCP", "AWS", "Azure", "Docker", "CI/CD", "GitHub Actions", "TypeScript", "Angular Material", "Linux", "Bash", "ruff", "mypy"] },
];

const EXPERIENCE = [
  {
    co: "Monocept", role: "Software Engineer", date: "Jan 2026 — Present",
    projects: [
      {
        proj: "AgentFX — Agentic Claims & Fraud Automation (Insurance)",
        stack: "Python 3.12 · FastAPI · Pydantic v2 · LiteLLM · PostgreSQL + pgvector · SQLAlchemy · Alembic · scikit-learn · Angular 17",
        bullets: [
          "Architected a <b>config-driven agentic framework</b> where each customer is onboarded and tuned from configuration alone — new tenants, routing, rule packs and pipelines go live <b>without redeploying</b>.",
          "Built the <b>claims fraud-detection</b> pipeline as cooperating agents that hand off <b>agent-to-agent</b> — extraction → aggregation → multi-dimension scoring — to reach a single <b>final fraud verdict</b> with rationale.",
          "Added <b>document forensics</b> — tampering detection (EXIF / ELA / PDF-structure) and <b>AI-generated document detection</b> — to catch manipulated or synthetic claim documents before straight-through processing.",
          "Built the <b>RAG</b> stack: watcher-driven ingestion, pluggable chunkers, <b>hybrid</b> dense (pgvector) + BM25 retrieval fused via RRF, cross-encoder rerank, and grounded citations.",
          "Built a <b>call-intelligence pipeline</b> — transcription → analysis → quality and lead scoring — as a pluggable agent pack.",
          "Hardened LLM access behind a provider-agnostic <b>AI gateway</b>: only authorized consumers can reach the models — any other machine that pings the LLMs is denied (per-consumer keyed access).",
        ],
      },
      {
        proj: "NeuralShell — Autonomous Multi-Agent Code Generation",
        stack: "Python 3.11+ · FastAPI · WebSocket · Ollama (qwen2.5-coder) · MySQL · Docker · Textual (TUI) · ruff · mypy",
        bullets: [
          "Built <b>NeuralShell</b>, an autonomous <b>multi-agent system</b> for code writing, review, testing, and deployment — code-gen quality rated <b>~90%</b> via manual review.",
          "Introduced an <b>ArchitectureNode</b> for intelligent codebase parsing and change-location detection before any modification.",
          "Implemented parallel agent nodes (Code / Review / Testing / Deploy) coordinated by a <b>WorkflowRouter</b> that dynamically delegates tasks.",
          "Designed custom <b>agent tools</b> (file read/write, codebase navigation, context retrieval) exposed via <b>function calling</b>, with a self-updating context file that preserves project awareness across runs.",
          "Shipped a Textual <b>TUI client</b> with interactive mode, slash commands, dry-run previews, and target scoping — deployable across any codebase.",
        ],
      },
    ],
  },
  {
    co: "Monocept", role: "Software Intern", date: "May 2025 — Jan 2026",
    projects: [
      {
        proj: "MozartBot — Multi-Tenant RAG Chatbot",
        stack: "Python · FastAPI · LangChain · LangGraph · PostgreSQL · pgvector · TypeScript · Angular Material · Ollama",
        bullets: [
          "Architected a multi-node <b>LangGraph</b> workflow (retrieval → grading → generation) with <b>semantic + late chunking</b> and checkpoint-based memory over <b>pgvector</b> — document Q&A in <b>5–7s</b>.",
          "Built a multi-format <b>document pipeline</b> (PDF, DOCX, Excel, CSV, image OCR) with PyMuPDF multi-page table extraction and token-aware chunking into a <b>multi-tenant</b> pgvector store with per-company database isolation.",
